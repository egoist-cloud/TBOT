# ============================================================
# Quantum (TBOT) — пример переменных окружения.
# Скопируй в .env и заполни значения. НИКОГДА не коммить .env
# (он уже в .gitignore).
# ============================================================

# ---------- Discord ----------
# Токен бота (https://discord.com/developers/applications)
DISCORD_TOKEN=
# ID сервера (Developer Mode -> правый клик по серверу -> Copy ID)
GUILD_ID=

# ---------- Роли ----------
# Роль, выдаваемая автоматически при принятии заявки
ACCEPT_ROLE_ID=1448368118190837800
# Устаревшее имя той же роли (оставлено для совместимости)
AUTO_ROLE_ID=
# Роль «старший модератор» (может рассматривать заявки)
ALLOWED_ROLE_ID=
# Вторая роль ревьюера
REVIEWER_ROLE_ID_2=
# Роль, которой разрешено голосовать много раз (спам-голоса)
SPAM_VOTE_ROLE_ID=
# Дополнительные роли ревьюеров
EXTRA_REVIEWER_ROLE_1=
EXTRA_REVIEWER_ROLE_2=
EXTRA_REVIEWER_ROLE_3=
# Роль без cooldown-а
NO_COOLDOWN_ROLE_ID=
# Роль активности
ACTIVITY_ROLE_ID=
# Роль, обходящая привязку
BYPASS_ROLE_ID=

# ---------- Клан ----------
CLAN_NAME=
CLAN_URL=

# ---------- cs2red (секреты!) ----------
# Либо одной строкой "name=value; name2=value2", либо отдельными
# переменными ниже. CS2RED_COOKIE_STRING имеет приоритет.
CS2RED_COOKIE_STRING=
CS2RED_TOKEN=
CS2RED_BH=
CS2RED_I=
CS2RED_YASC=
CS2RED_BROWSER_ID=
CS2RED_YANDEXUID=
CS2RED_YUIDSS=
CS2RED_DDG1=
CS2RED_DDG8=
CS2RED_DDG9=
CS2RED_DDG10=
CS2RED_YABS_SID=
CS2RED_YM_UID=
CS2RED_YM_D=
CS2RED_YM_ISAD=
CS2RED_YMEX=

# ---------- Защита cs2red и скорость ----------
# Пауза между запросами к cs2red, секунды. Ниже 1.5 повышает риск 429.
CS2RED_RATE_LIMIT_SECONDS=2.5
# Предохранитель после 429/403/5xx: базовая пауза и максимум, секунды.
# Пауза растёт экспоненциально (60 → 120 → 240 …), но не выше максимума.
CS2RED_BLOCK_BASE_SECONDS=60
CS2RED_BLOCK_MAX_SECONDS=1800
# Время жизни кэша профиля игрока, секунды (0 отключает кэш).
CS2RED_USER_CACHE_TTL=60

# ---------- Steam ----------
STEAM_API_KEY=

# ---------- GitHub-синк ----------
# Токен с правами на репозиторий (не обязателен)
GITHUB_TOKEN=
# owner/repo
GITHUB_REPO=
# ветка
GITHUB_BRANCH=main
# путь к данным внутри репозитория
GITHUB_BASE_PATH=

# ---------- Бот ----------
# Сколько голосов нужно для принятия/отклонения заявки
VOTES_REQUIRED=1
# Период синхронизации ролей, минут
SYNC_INTERVAL_MINUTES=15
# Папка с данными (quantum.db, links.json, rules.txt и т.п.)
DATA_DIR=.
# Порт HTTP-сервера health-check (Render задаёт сам)
PORT=8080

# ---------- ИИ (RAG по правилам) ----------
# Каскад ИИ: при лимите/ошибке запрос уходит следующему провайдеру.
# Порядок: Gemini -> Groq -> Cerebras -> Mistral -> GitHub Models ->
# OpenRouter -> NVIDIA -> SambaNova -> Cohere -> HuggingFace ->
# Cloudflare -> LLM7. Достаточно любого одного ключа.
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
# GitHub Models: отдельный токен, иначе берётся GITHUB_TOKEN
GITHUB_MODELS_TOKEN=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
SAMBANOVA_API_KEY=
COHERE_API_KEY=
HUGGINGFACE_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
LLM7_API_KEY=

# Модели (можно не задавать — берутся значения по умолчанию)
GROQ_MODEL=llama-3.3-70b-versatile
CEREBRAS_MODEL=gpt-oss-120b
MISTRAL_MODEL=mistral-small-latest
GITHUB_MODELS_MODEL=openai/gpt-4o-mini
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct
COHERE_MODEL=command-a-03-2025
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct

# Пауза провайдера после ошибки, секунды (лимит / неверный ключ / конфиг)
AI_PROVIDER_COOLDOWN_SECONDS=600
AI_PROVIDER_AUTH_COOLDOWN_SECONDS=3600
AI_PROVIDER_CONFIG_COOLDOWN_SECONDS=1800
AI_PROVIDER_ERROR_COOLDOWN_SECONDS=120

# База знаний проекта для ИИ (файл в DATA_DIR)
AI_PROJECT_FILE=ai_project.md
# Модель Gemini (по умолчанию gemini-2.5-flash; gemini-1.5-* удалены Google)
GEMINI_MODEL=
# Модель для OpenRouter
OPENROUTER_MODEL=
# Селектор модели LLM7: default / fast / pro
LLM7_MODEL=default
# Устаревшая общая переменная: используется как запасная, если
# GEMINI_MODEL / LLM7_MODEL не заданы
AI_MODEL=
# Лимит токенов в ответе
AI_MAX_OUTPUT_TOKENS=2000
# Таймаут запроса к LLM, секунды
AI_REQUEST_TIMEOUT=30
# Время жизни кэша ответов ИИ, секунды
AI_CACHE_TTL_SECONDS=86400
# Сколько запросов к ИИ один пользователь может сделать в час
AI_USER_REQUESTS_PER_HOUR=20
# Переопределение адресов API (обычно не нужно)
GEMINI_API_URL=
OPENROUTER_BASE_URL=
LLM7_BASE_URL=

# ---------- ИИ-агент (наблюдение за системой) ----------
# Канал, куда агент пишет об ошибках, отчёты и идеи
AGENT_CHANNEL_ID=1556427610160889907
# Куда /check_all пишет мини-отчёт о найденных мутах/банах (по умолчанию — лог-канал)
CHECK_LOG_CHANNEL_ID=1511463623703265361
# Период цикла наблюдения, минуты
AGENT_CHECK_MINUTES=30
# Как часто публиковать отчёт о состоянии систем, минуты
AGENT_HEALTH_INTERVAL_MINUTES=120
# Как часто публиковать идею по улучшению бота, минуты
AGENT_IDEA_INTERVAL_MINUTES=360

# ---------- Заявки ----------
# Раз в сколько часов пересоздавать панель с условиями и выбором клана
# (старое сообщение удаляется, публикуется новое).
CLAN_PANEL_REFRESH_HOURS=72
# Через сколько дней без решения заявка закрывается автоматически.
# 0 — не закрывать (тогда «зависшая» заявка блокирует новую подачу).
APPLICATION_TTL_DAYS=7
# Канал с копией заявок и кнопками запретов (по умолчанию — канал заявок).
# Кнопка «Взять» публикуется только в ветке заявки, не в канале.
APPLICATION_LOGS_CHANNEL_ID=1511463623703265361
# Канал аудита админских и модераторских действий (embed-копии всех
# привязок, запретов, выдач прав, решений по заявкам и синхронизаций).
AUDIT_LOG_CHANNEL_ID=1555204495682568202
# Канал с панелью «Получить роль» (мини-embed + кнопка авто-привязки)
ROLE_PANEL_CHANNEL_ID=1556232762586046535

# Роль клана TALENT для /check_all, /check_clan, /check_onlineall
TALENT_ROLE_ID=1448368118190837800
# Удалять роли кланов, которые никто не носит (0 — не удалять).
# Трогаются только роли, которые ведёт бот (clan_roles.json), не BAN/модераторы.
CLAN_ROLE_CLEANUP=1
# Как часто удалять роли кланов без участников, часы (первый прогон —
# тоже через интервал после старта). Принудительно — /clan_roleclear.
CLAN_ROLE_CLEANUP_HOURS=10
# Названия ролей cs2red для Discord, если сайт не отдал список ролей.
# JSON: roleId -> название. Бот создаёт роль сам, если её нет на сервере.
# Пример: SITE_ROLE_NAMES={"2": "Куратор"}
SITE_ROLE_NAMES=
# Глубина отчёта /check_all в днях
CHECK_ALL_DAYS=14
# Минимальный недельный онлайн (часы) для /check_onlineall
ONLINE_MIN_HOURS=9

# ---------- Мониторинг ----------
# Уровень логирования: DEBUG/INFO/WARNING/ERROR. Стартовые сообщения
# quantum.env и quantum.db идут в общий лог с этим уровнем.
LOG_LEVEL=INFO
# Период health-check (проверка cs2red, ИИ, Discord), минуты
HEALTH_CHECK_MINUTES=15
# Авто-привязка по никам раз в N часов (запускается только если есть
# непривязанные участники; ручной /auto_link тоже блокирует параллельный запуск).
# После перезапуска бот ждёт полный интервал, а не стартует сразу.
AUTO_LINK_INTERVAL_HOURS=3
# Синхронизация ролей всех привязанных, минуты (120 = раз в 2 часа).
# Первый прогон — тоже через полный интервал после старта; принудительно —
# кнопка «Синхронизация» в панели или команда /sync_all.
SYNC_ALL_INTERVAL_MINUTES=120
# Час UTC ежедневной сводки
DAILY_SUMMARY_HOUR=9
