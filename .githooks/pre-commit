#!/bin/sh
# pre-commit: не пускать в историю сломанные правки.
#
# Что делает: ruff по всему проекту — всегда; pytest — только если в индексе
# есть python-файлы или конфиги тестов (коммиты документации не ждут прогон).
# Любая ошибка отменяет коммит. Осознанно обойти: git commit --no-verify.
#
# Установка (один раз на клон):
#   git config core.hooksPath .githooks
set -eu

# Хук запускается из корня репозитория, но на всякий случай фиксируем cwd:
# так команды работают и при коммите из подкаталога.
cd "$(git rev-parse --show-toplevel)"

PY="${PYTHON:-python}"
if ! command -v "$PY" >/dev/null 2>&1; then
    echo "[pre-commit] не найден $PY — активируйте venv или задайте PYTHON=..." >&2
    exit 1
fi

echo "[pre-commit] ruff"
if ! "$PY" -m ruff check .; then
    echo "[pre-commit] ruff нашёл ошибки — коммит отменён" >&2
    echo "[pre-commit] обойти осознанно: git commit --no-verify" >&2
    exit 1
fi

# Тесты нужны, только если менялся код или конфиги тестов: иначе коммит
# документации зря ждал бы ~5 с. Удаления тоже учитываются (--name-only без
# фильтра): удалённый .py может сломать импорты.
staged="$(git diff --cached --name-only)"
run_tests=false
while IFS= read -r f; do
    [ -n "$f" ] || continue
    case "$f" in
        *.py | pytest.ini | pyproject.toml | setup.cfg | tox.ini | requirements*.txt)
            run_tests=true
            break
            ;;
    esac
done <<EOF
$staged
EOF

if [ "$run_tests" = true ]; then
    echo "[pre-commit] pytest"
    # --no-cov: таблица покрытия на каждом коммите не нужна и замедляет хук
    if ! "$PY" -m pytest -q --no-cov; then
        echo "[pre-commit] тесты упали — коммит отменён" >&2
        echo "[pre-commit] обойти осознанно: git commit --no-verify" >&2
        exit 1
    fi
else
    echo "[pre-commit] pytest пропущен: в индексе нет python-файлов и конфигов тестов"
fi

echo "[pre-commit] OK"
